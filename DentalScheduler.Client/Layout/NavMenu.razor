@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using DentalScheduler.Client.Auth
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@using Blazored.LocalStorage
@inject ILocalStorageService LocalStorage

<nav class="navbar navbar-expand-md navbar-dark mb-4 sticky-top" style="background-color: #009688; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);">
    <div class="container">
        <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="">
            <MudIcon Icon="@Icons.Material.Filled.LocalHospital" Color="Color.Surface" Size="Size.Large" /> 
            DentalScheduler
        </a>
        <button class="navbar-toggler shadow-none border-0" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="@NavMenuCssClass navbar-collapse" @onclick="ToggleNavMenu">
            <ul class="navbar-nav me-auto mb-2 mb-md-0">
                <li class="nav-item">
                    <NavLink class="nav-link px-3 d-flex align-items-center gap-1" href="" Match="NavLinkMatch.All">
                        <MudIcon Icon="@Icons.Material.Filled.Home" Size="Size.Small" /> Acasă
                    </NavLink>
                </li>
                @if (isAuthenticated)
                {
                    @if (isAdmin)
                    {
                        <li class="nav-item">
                            <NavLink class="nav-link d-flex align-items-center gap-1" href="admin-dashboard">
                                <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Size="Size.Small" /> Dashboard Admin
                            </NavLink>
                        </li>
                    }
                    else if (isDoctor)
                    {
                        <li class="nav-item">
                            <NavLink class="nav-link d-flex align-items-center gap-1" href="doctor-dashboard">
                                <MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="Size.Small" /> Dashboard Medic
                            </NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link d-flex align-items-center gap-1" href="appointments">
                                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" /> Programări
                            </NavLink>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <NavLink class="nav-link d-flex align-items-center gap-1" href="appointments">
                                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" /> Programările Mele
                            </NavLink>
                        </li>
                    }
                }
            </ul>

            <ul class="navbar-nav ms-auto mb-2 mb-md-0 d-flex align-items-center">
                @if (isAuthenticated)
                {
                    <li class="nav-item d-flex align-items-center text-white mx-3 d-none d-md-block">
                        <span class="opacity-50">|</span>
                    </li>
                    <li class="nav-item d-flex align-items-center">
                        <NavLink class="nav-link text-white me-3 d-flex align-items-center" href="profile">
                            @if (!string.IsNullOrEmpty(profilePictureUrl))
                            {
                                <img src="@GetFullImageUrl(profilePictureUrl)" 
                                     class="rounded-circle me-2 border border-white" 
                                     style="width: 32px; height: 32px; object-fit: cover;" 
                                     alt="Profile" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Size="Size.Medium" Class="me-1" />
                            }
                            <span class="fw-light">Salut, <strong>@displayName</strong>!</span>
                        </NavLink>
                    </li>
                    <li class="nav-item d-flex align-items-center ms-2">
                        <MudButton Variant="Variant.Outlined" Color="Color.Surface" Size="Size.Small" StartIcon="@Icons.Material.Filled.Logout" OnClick="Logout" Class="rounded-pill px-4 fw-bold" Style="border-color: rgba(255,255,255,0.5); border-width: 1.5px; opacity: 0.9;">Logout</MudButton>
                    </li>
                }
                else
                {
                    <li class="nav-item ms-md-2">
                        <MudButton Href="login" Variant="Variant.Text" Color="Color.Surface">Autentificare</MudButton>
                    </li>
                    <li class="nav-item ms-md-1">
                        <MudButton Href="register" Variant="Variant.Filled" Color="Color.Surface" Class="mud-theme-primary text-primary fw-bold rounded-pill ms-2">Înregistrare</MudButton>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

@code {
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;
    private bool isAuthenticated;
    private bool isAdmin;
    private bool isDoctor;
    private string displayName = "Utilizator";
    private string? profilePictureUrl;
    private const string ApiBaseUrl = "http://localhost:5062";

    protected override async Task OnInitializedAsync()
    {
        await UpdateAuthState();
        AuthStateProvider.AuthenticationStateChanged += OnAuthStateChanged;
    }

    private async void OnAuthStateChanged(Task<AuthenticationState> task)
    {
        await UpdateAuthState();
        await InvokeAsync(StateHasChanged);
    }

    private async Task UpdateAuthState()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        isAuthenticated = user.Identity?.IsAuthenticated ?? false;
        isAdmin = user.IsInRole("Admin");
        isDoctor = user.IsInRole("Doctor");

        if (isAuthenticated)
        {
            // Try to get profile picture from local storage
            profilePictureUrl = await LocalStorage.GetItemAsync<string>("profilePictureUrl");
        }

        var name = user.Identity?.Name
            ?? user.FindFirst(ClaimTypes.Email)?.Value
            ?? user.FindFirst("email")?.Value;

        if (!string.IsNullOrWhiteSpace(name))
        {
            var atIndex = name.IndexOf('@');
            displayName = atIndex >= 0 ? name[..atIndex] : name;
        }
        else
        {
            displayName = "Utilizator";
        }
    }

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;

    private async Task Logout()
    {
        await LocalStorage.RemoveItemAsync("authToken");
        await LocalStorage.RemoveItemAsync("userClaims");
        await LocalStorage.RemoveItemAsync("userId");
        await LocalStorage.RemoveItemAsync("profilePictureUrl");
        ((CustomAuthenticationStateProvider)AuthStateProvider).MarkUserAsLoggedOut();
        Navigation.NavigateTo("/");
    }

    private string GetFullImageUrl(string? relativeUrl)
    {
        if (string.IsNullOrEmpty(relativeUrl)) return "";
        if (relativeUrl.StartsWith("http")) return relativeUrl;
        return $"{ApiBaseUrl}{relativeUrl}";
    }
}