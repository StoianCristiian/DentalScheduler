@page "/"
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Dental Scheduler - Home</PageTitle>

<div class="container py-5 animate-fade-in">
    <div class="row align-items-center mb-5">
        <div class="col-lg-6">
            <h1 class="display-4 fw-bold mb-3 ls-1">
                Zâmbetul tău, <br />
                <span class="text-gradient">Prioritatea noastră.</span>
            </h1>
            <p class="lead text-muted mb-4">
                Programări stomatologice rapide și ușoare. Gestionează-ți vizitele la dentist într-un mod modern și eficient.
            </p>
            
            <div class="d-flex gap-3">
                @if (isAuthenticated)
                {
                    @if (isDoctor)
                    {
                        <a href="doctor-dashboard" class="btn btn-primary btn-lg shadow-sm px-4 btn-hover-effect">
                            📋 Dashboard Medic
                        </a>
                    }
                    else
                    {
                        <a href="appointments" class="btn btn-primary btn-lg shadow-sm px-4 btn-hover-effect">
                            📅 Programările Mele
                        </a>
                    }
                }
                else
                {
                    <a href="login" class="btn btn-primary btn-lg shadow-sm px-4 btn-hover-effect">Programează-te Acum</a>
                    <a href="register" class="btn btn-outline-secondary btn-lg px-4 btn-hover-effect">Cont Nou</a>
                }
            </div>
        </div>
        <div class="col-lg-6 d-none d-lg-block text-center">
            <!-- Placeholder for hero image if you add one later -->
            <div class="p-5 rounded-circle bg-light d-inline-block shadow-sm" style="width: 400px; height: 400px; display: flex !important; align-items: center; justify-content: center; font-size: 5rem;">
                🦷
            </div>
        </div>
    </div>
</div>

@code {
    private bool isAuthenticated;
    private bool isDoctor;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAuthenticated = user.Identity?.IsAuthenticated ?? false;
        isDoctor = user.IsInRole("Doctor");
    }
}
