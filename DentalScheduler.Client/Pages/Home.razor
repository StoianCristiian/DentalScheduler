@page "/"
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Dental Scheduler - Home</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-8">
    <MudGrid Class="mb-10 align-center">
        <MudItem xs="12" md="6">
            <MudText Typo="Typo.h2" Color="Color.Primary" Class="mb-4">
                <b>Zâmbetul tău,<br />Prioritatea noastră.</b>
            </MudText>
            <MudText Typo="Typo.h6" Class="mb-6 mud-text-secondary">
                Oferim servicii stomatologice de top în cabinete moderne, echipate cu tehnologie de ultimă generație. 
                Găsește clinica potrivită și programează-te simplu și rapid.
            </MudText>
            
            <div class="d-flex gap-4">
                @if (isAuthenticated)
                {
                    @if (isDoctor)
                    {
                        <MudButton Href="doctor-dashboard" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Filled.Dashboard">
                            Dashboard Medic
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Href="appointments" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Filled.CalendarMonth">
                            Programările Mele
                        </MudButton>
                    }
                }
                else
                {
                    <MudButton Href="login" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large">Programează-te Acum</MudButton>
                    <MudButton Href="register" Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Large">Cont Nou</MudButton>
                }
            </div>
        </MudItem>
        <MudItem xs="12" md="6" Class="d-flex justify-center">
            <MudImage Src="Images/cabinet4.jpg" Elevation="25" Class="rounded-lg" ObjectFit="ObjectFit.Cover" Width="500" Height="400" />
        </MudItem>
    </MudGrid>

    <MudText Typo="Typo.h3" Align="Align.Center" Class="mb-8 mt-16" Color="Color.Primary">Cabinetele Noastre</MudText>

    <MudGrid Class="mb-16">
        <MudItem xs="12" md="4">
            <MudCard Elevation="4" Class="h-100 pa-2">
                <MudCardMedia Image="Images/cabinet1.jpg" Height="250" />
                <MudCardContent>
                    <MudText Typo="Typo.h5" Class="mb-2"><strong>Dental Center - Central</strong></MudText>
                    <MudText Typo="Typo.body2">Echipamente moderne și o echipă de specialiști dedicați sănătății tale orale, chiar în inima orașului.</MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary">Vezi Detalii</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
        
        <MudItem xs="12" md="4">
            <MudCard Elevation="4" Class="h-100 pa-2">
                <MudCardMedia Image="Images/cabinet2.jpg" Height="250" />
                <MudCardContent>
                    <MudText Typo="Typo.h5" Class="mb-2"><strong>Smile Clinic - Nord</strong></MudText>
                    <MudText Typo="Typo.body2">Specializați în estetică dentară și implantologie, oferim tratamente premium într-o atmosferă relaxantă.</MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary">Vezi Detalii</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
        
        <MudItem xs="12" md="4">
            <MudCard Elevation="4" Class="h-100 pa-2">
                <MudCardMedia Image="Images/cabinet3.jpeg" Height="250" />
                <MudCardContent>
                    <MudText Typo="Typo.h5" Class="mb-2"><strong>Family Dent - Vest</strong></MudText>
                    <MudText Typo="Typo.body2">Cabinet dedicat întregii familii, cu servicii de stomatologie pediatrică și ortodonție de înaltă calitate.</MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary">Vezi Detalii</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private bool isAuthenticated;
    private bool isDoctor;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAuthenticated = user.Identity?.IsAuthenticated ?? false;
        isDoctor = user.IsInRole("Doctor");
    }
}
