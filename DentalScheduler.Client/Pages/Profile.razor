@page "/profile"
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Headers
@using Blazored.LocalStorage
@using Microsoft.AspNetCore.Authorization
@using DentalScheduler.Client.Auth
@attribute [Authorize]
@inject HttpClient Http
@inject ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Profilul Meu</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-8 animate-fade-in">
    <MudGrid Justify="Justify.Center">
        <MudItem xs="12" md="10" lg="9">
            <MudPaper Elevation="6" Class="rounded-xl overflow-hidden mb-6">
                <!-- Cover Photo Area -->
                <MudPaper Square="true" Elevation="0" Color="Color.Primary" Class="position-relative" Style="height: 160px;">
                    <div class="position-absolute top-0 start-0 w-100 h-100 opacity-25" 
                         style="background-image: repeating-linear-gradient(45deg, transparent, transparent 10px, rgba(255,255,255,0.1) 10px, rgba(255,255,255,0.1) 20px);"></div>
                </MudPaper>

                <div class="px-6 px-md-10 pb-8">
                    <MudGrid>
                        <!-- Left Side: Profile Card -->
                        <MudItem xs="12" md="4" Class="position-relative">
                            <div class="d-flex flex-column align-center mt-n12">
                                <div class="position-relative">
                                    @if (!string.IsNullOrEmpty(_userProfile.ProfilePictureUrl))
                                    {
                                        <MudAvatar Style="width: 150px; height: 150px; border: 5px solid white;" Elevation="4">
                                            <MudImage Src="@GetFullImageUrl(_userProfile.ProfilePictureUrl)" ObjectFit="ObjectFit.Cover" Alt="Profile" Class="w-100 h-100" />
                                        </MudAvatar>
                                    }
                                    else
                                    {
                                        <MudAvatar Color="Color.Surface" Style="width: 150px; height: 150px; border: 5px solid white;" Elevation="4">
                                            <MudIcon Icon="@Icons.Material.Filled.Person" Style="font-size: 5rem;" Color="Color.Default" />
                                        </MudAvatar>
                                    }

                                    <!-- Camera Upload Button -->
                                    <div class="position-absolute bottom-0 end-0" style="transform: translate(-5px, -5px);">
                                        <MudIconButton HtmlTag="label" 
                                                       for="profilePicInput"
                                                       Color="Color.Primary" 
                                                       Variant="Variant.Filled" 
                                                       Icon="@Icons.Material.Filled.CameraAlt" 
                                                       Size="Size.Medium" 
                                                       Style="border: 3px solid white; border-radius: 50%;" />
                                        <InputFile id="profilePicInput" OnChange="UploadProfilePictureContext" hidden accept=".jpg,.jpeg,.png" />
                                    </div>
                                </div>
                                
                                <MudText Typo="Typo.h5" Class="fw-bold mt-4">@_userProfile.FirstName @_userProfile.LastName</MudText>
                                <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Class="mt-1 mb-3">@_userProfile.Role</MudChip>
                                
                                <MudText Typo="Typo.body2" Class="text-muted d-flex align-center">
                                    <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Class="me-1" />
                                    @(string.IsNullOrWhiteSpace(_userProfile.Address) ? "Adresă nespecificată" : _userProfile.Address.Split(',')[0])
                                </MudText>
                            </div>
                        </MudItem>

                        <!-- Right Side: Edit Form -->
                        <MudItem xs="12" md="8" Class="ps-md-8 pt-6">
                            <div class="d-flex align-center mb-6 pb-2" style="border-bottom: 1px solid #e0e0e0;">
                                <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Color="Color.Primary" Size="Size.Medium" Class="me-3" />
                                <MudText Typo="Typo.h5" Class="fw-bold">Setări Cont</MudText>
                            </div>

                            @if (!string.IsNullOrEmpty(_successMessage))
                            {
                                <MudAlert Severity="Severity.Success" Class="mb-4">@_successMessage</MudAlert>
                            }
                            @if (!string.IsNullOrEmpty(_errorMessage))
                            {
                                <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
                            }

                            @if (_isLoading)
                            {
                                <div class="d-flex justify-center align-center py-8">
                                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="me-3" />
                                    <MudText Typo="Typo.body1" Class="text-muted fw-medium">Se încarcă datele...</MudText>
                                </div>
                            }
                            else
                            {
                                <EditForm Model="@_userProfile" OnValidSubmit="SaveProfile">
                                    <DataAnnotationsValidator />
                                    
                                    <MudGrid>
                                        <MudItem xs="12" sm="6">
                                            <MudTextField @bind-Value="_userProfile.FirstName" 
                                                          Label="Prenume" 
                                                          Variant="Variant.Outlined" 
                                                          Margin="Margin.Normal"
                                                          For="@(() => _userProfile.FirstName)" />
                                        </MudItem>
                                        
                                        <MudItem xs="12" sm="6">
                                            <MudTextField @bind-Value="_userProfile.LastName" 
                                                          Label="Nume" 
                                                          Variant="Variant.Outlined" 
                                                          Margin="Margin.Normal"
                                                          For="@(() => _userProfile.LastName)" />
                                        </MudItem>

                                        <MudItem xs="12">
                                            <MudTextField Value="@_userProfile.Email" 
                                                          Label="Adresă de Email" 
                                                          Variant="Variant.Outlined" 
                                                          Margin="Margin.Dense"
                                                          ReadOnly="true"
                                                          Disabled="true"
                                                          Adornment="Adornment.End"
                                                          AdornmentIcon="@Icons.Material.Filled.Lock" />
                                        </MudItem>

                                        <MudItem xs="12">
                                            <MudTextField @bind-Value="_userProfile.PhoneNumber" 
                                                          Label="Număr Telefon" 
                                                          Variant="Variant.Outlined" 
                                                          Margin="Margin.Normal"
                                                          Placeholder="07xx"
                                                          For="@(() => _userProfile.PhoneNumber)" />
                                        </MudItem>

                                        <MudItem xs="12">
                                            <MudTextField @bind-Value="_userProfile.Address" 
                                                          Label="Adresă completă" 
                                                          Variant="Variant.Outlined" 
                                                          Margin="Margin.Normal"
                                                          Lines="3"
                                                          For="@(() => _userProfile.Address)" />
                                        </MudItem>

                                        <MudItem xs="12" Class="d-flex justify-end mt-4">
                                            <MudButton ButtonType="ButtonType.Submit" 
                                                       Variant="Variant.Filled" 
                                                       Color="Color.Primary" 
                                                       Disabled="@_isSaving" 
                                                       Class="px-8 rounded-pill fw-bold shadow-sm"
                                                       Size="Size.Large">
                                                @if (_isSaving)
                                                {
                                                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                                    <span class="ms-2">Se salvează...</span>
                                                }
                                                else
                                                {
                                                    <span>Salvează Modificările</span>
                                                }
                                            </MudButton>
                                        </MudItem>
                                    </MudGrid>
                                </EditForm>
                            }
                        </MudItem>
                    </MudGrid>
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private UserProfileModel _userProfile = new();
    private bool _isLoading = true;
    private bool _isSaving;
    private string? _successMessage;
    private string? _errorMessage;
    // URL-ul de bază trebuie să fie cel al API-ului (port 5062)
    private const string ApiBaseUrl = "http://localhost:5062"; 

    protected override async Task OnInitializedAsync()
    {
        await LoadProfile();
    }

    private async Task LoadProfile()
    {
        _isLoading = true;
        try
        {
            _userProfile = await Http.GetFromJsonAsync<UserProfileModel>("api/auth/me") ?? new();
        }
        catch
        {
            _errorMessage = "Eroare la încărcarea profilului.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveProfile()
    {
        _isSaving = true;
        _successMessage = null;
        _errorMessage = null;

        try
        {
            var response = await Http.PutAsJsonAsync("api/auth/profile", new
            {
                _userProfile.FirstName,
                _userProfile.LastName,
                _userProfile.PhoneNumber,
                _userProfile.Address
            });

            if (response.IsSuccessStatusCode)
            {
                _successMessage = "Profilul a fost actualizat cu succes!";
            }
            else
            {
                _errorMessage = "Nu s-a putut actualiza profilul.";
            }
        }
        catch(Exception ex)
        {
            _errorMessage = "Eroare: " + ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }
    
    private async Task UploadProfilePictureContext(InputFileChangeEventArgs e)
    {
        await UploadProfilePicture(e.File);
    }

    private async Task UploadProfilePicture(IBrowserFile file)
    {
        if (file == null) return;

        // Limita de 5MB
        if (file.Size > 5120000)
        {
            _errorMessage = "Imaginea trebuie să fie mai mică de 5MB.";
            return;
        }

        try 
        {
            var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(file.OpenReadStream(5120000));
            fileContent.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType);
            content.Add(fileContent, "file", file.Name);

            var response = await Http.PostAsync("api/auth/profile-picture", content);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<UploadResponse>();
                if (result != null)
                {
                    // Salvam URL-ul in LocalStorage pentru NavMenu si alte componente
                    await LocalStorage.SetItemAsync("profilePictureUrl", result.FileUrl);

                    // Force image refresh by appending timestamp
                    _userProfile.ProfilePictureUrl = result.FileUrl + "?t=" + DateTime.Now.Ticks;
                    _successMessage = "Fotografia de profil a fost actualizată!";
                    
                    // Notificam NavMenu ca s-a schimbat ceva (pentru a reciti poza din LocalStorage)
                    if (AuthStateProvider is CustomAuthenticationStateProvider customAuth)
                    {
                        customAuth.NotifyUserUpdated();
                    }

                    StateHasChanged();
                }
            }
            else
            {
                _errorMessage = "Eroare la încărcarea imaginii.";
            }
        }
        catch(Exception ex)
        {
            _errorMessage = "Eroare: " + ex.Message;
        }
    }

    private string GetFullImageUrl(string? relativeUrl)
    {
        if (string.IsNullOrEmpty(relativeUrl)) return "";
        
        // Remove query parameters like ?t=123 from the check
        var baseUrl = relativeUrl.Split('?')[0];

        if (baseUrl.StartsWith("http")) return relativeUrl;
        
        // În cazul în care serverul returnează doar o cale relativă (din trecut)
        return $"{ApiBaseUrl}{relativeUrl}";
    }

    public class UserProfileModel
    {
        public string Id { get; set; } = "";
        
        [Required(ErrorMessage = "Prenumele este obligatoriu.")]
        public string FirstName { get; set; } = "";
        
        [Required(ErrorMessage = "Numele este obligatoriu.")]
        public string LastName { get; set; } = "";
        
        public string Email { get; set; } = "";
        public string Role { get; set; } = "";
        public string PhoneNumber { get; set; } = "";
        public string Address { get; set; } = "";
        public string ProfilePictureUrl { get; set; } = "";
    }

    public class UploadResponse { public string FileUrl { get; set; } = ""; }
}
