@page "/appointments"
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using System.Text.Json.Serialization
@using Blazored.LocalStorage
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using MudBlazor
@attribute [Authorize]
@inject HttpClient Http
@inject ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Programările Mele</PageTitle>

<div class="container mt-4 animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0 fw-bold d-flex align-items-center">
                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Color="Color.Primary" Size="Size.Large" Class="me-2" /> 
                Programările Mele
            </h2>
            <p class="text-muted mb-0">Gestionează istoricul și viitoarele tale vizite</p>
        </div>
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ShowSmartModal" Class="rounded-pill px-4 fw-bold">
                <MudIcon Icon="@Icons.Material.Filled.Lightbulb" Class="me-2" /> Recomandare Smart
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ShowModal" Class="rounded-pill px-4 fw-bold">
                <MudIcon Icon="@Icons.Material.Filled.Add" Class="me-2" /> Programare Nouă
            </MudButton>
        </div>
    </div>

    <AlertMessage Message="@successMessage" Type="AlertMessage.AlertType.Success" />
    <AlertMessage Message="@errorMessage" Type="AlertMessage.AlertType.Danger" />

    <div class="card shadow border-0 overflow-hidden">
        <div class="card-body p-0">
            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Se încarcă...</span>
                    </div>
                    <p class="mt-2 text-muted fw-semibold">Se încarcă programările...</p>
                </div>
            }
            else if (appointments == null || appointments.Count == 0)
            {
                <div class="text-center py-5">
                    <div class="mb-3 text-muted opacity-50 display-1">
                        <i class="bi bi-calendar-x"></i>
                    </div>
                    <h4>Nu ai nicio programare.</h4>
                    <p class="text-muted">Apasă pe butonul "Programare Nouă" pentru a crea una.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-secondary small text-uppercase ls-1">
                            <tr>
                                <th class="border-0 py-3 ps-4">Data</th>
                                <th class="border-0 py-3">Ora</th>
                                <th class="border-0 py-3">Medic</th>
                                <th class="border-0 py-3">Tratament</th>
                                <th class="border-0 py-3">Note</th>
                                <th class="border-0 py-3 pe-4 text-end">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appt in appointments)
                            {
                                <tr>
                                    <td class="ps-4 py-3 fw-semibold">
                                        <div class="d-flex align-items-center">
                                            <div class="d-flex align-items-center justify-content-center rounded-3 me-3" style="width: 36px; height: 36px; background-color: #E0F2F1; color: #00796B;">
                                                <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" />
                                            </div>
                                            @appt.StartAt.ToShortDateString()
                                        </div>
                                    </td>
                                    <td class="py-3">@appt.StartAt.ToShortTimeString()</td>
                                    <td class="py-3">
                                        <div class="d-flex align-items-center">
                                           @if (!string.IsNullOrEmpty(appt.DentistProfilePictureUrl))
                                           {
                                               <img src="@GetFullImageUrl(appt.DentistProfilePictureUrl)"
                                                    class="rounded-circle me-2 border" 
                                                    style="width: 32px; height: 32px; object-fit: cover;" 
                                                    alt="Dr." />
                                           }
                                           else
                                           {
                                               <div class="avatar-sm bg-primary text-white rounded-circle me-2 d-flex align-items-center justify-content-center" style="width:32px; height:32px; font-size:12px;">Dr</div>
                                           }
                                           @appt.DentistName
                                        </div>
                                    </td>
                                    <td class="py-3"><span class="badge bg-light text-dark border fw-normal">@appt.TreatmentType</span></td>
                                    <td class="py-3 text-muted small">@appt.Notes</td>
                                    <td class="py-3 pe-4 text-end">
                                        @if (appt.Status == 1) // Price set by doctor - Patient chooses payment method
                                        {
                                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" OnClick="@(() => OpenPaymentModal(appt))" Disabled="@(processingId == appt.Id)" Class="rounded-pill px-3 shadow-none">
                                                @if (processingId == appt.Id)
                                                { <span class="spinner-border spinner-border-sm me-1"></span> }
                                                <MudIcon Icon="@Icons.Material.Filled.Payment" Size="Size.Small" Class="me-1" /> Confirmă Prezența
                                            </MudButton>
                                        }
                                        else if (appt.Status == 4) // Confirmed and paid
                                        {
                                            <span class="badge rounded-pill px-3 py-2 bg-success bg-opacity-10 border border-success text-success">
                                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="me-1 align-text-bottom" /> Confirmat
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill px-3 py-2 @GetStatusClass(appt.Status)">
                                                <MudIcon Icon="@GetStatusIcon(appt.Status)" Size="Size.Small" Class="me-1 align-text-bottom" /> @GetStatusLabel(appt.Status)
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@* Modal Programare Nouă *@
<MudOverlay @bind-Visible="showModal" DarkBackground="true" AutoClose="false" ZIndex="9999">
    <MudPaper Class="pa-6 rounded-xl animate-fade-in" Width="800px" MaxWidth="95vw" Elevation="8">
        <div class="d-flex justify-space-between align-center mb-2">
            <div>
                <MudText Typo="Typo.h5" Color="Color.Primary" Class="fw-bold d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Class="me-2" /> Programare Nouă
                </MudText>
                <MudText Typo="Typo.body2" Class="text-muted">Completează detaliile pentru a solicita o programare.</MudText>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CloseModal" Color="Color.Default" Size="Size.Small" />
        </div>

        <EditForm Model="@newAppt" OnValidSubmit="SaveAppointment">
            <DataAnnotationsValidator />
            
            <MudAlert Severity="Severity.Info" Class="my-4">
                Programarea va trebui confirmată de către medic.
            </MudAlert>

            <MudGrid>
                <MudItem xs="12">
                    <MudSelect T="string" @bind-Value="newAppt.DentistId" Label="Medic" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem T="string" Value="@("")">-- Alege medicul --</MudSelectItem>
                        @foreach (var d in filteredDoctors)
                        {
                            <MudSelectItem T="string" Value="@d.Id">Dr. @d.FullName</MudSelectItem>
                        }
                    </MudSelect>
                    <ValidationMessage For="@(() => newAppt.DentistId)" class="text-danger small mt-1" />
                </MudItem>

                <MudItem xs="12">
                    <MudSelect T="string" @bind-Value="newAppt.TreatmentType" Label="Tip Tratament" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem T="string" Value="@("")">-- Alege tratamentul --</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Control periodic")">Control periodic</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Detartraj")">Detartraj</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Obturaţie (Plombă)")">Obturaţie (Plombă)</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Extracţie")">Extracție</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Implant")">Implant</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Albire dentară")">Albire dentară</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Consultaţie")">Consultaţie</MudSelectItem>
                    </MudSelect>
                    <ValidationMessage For="@(() => newAppt.TreatmentType)" class="text-danger small mt-1" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="newApptDateFilter" Label="Data" MinDate="DateTime.Today" Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" />
                    <ValidationMessage For="@(() => newAppt.Date)" class="text-danger small mt-1" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="int" @bind-Value="newAppt.Hour" Label="Ora" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                        @for (int h = 8; h <= 17; h++)
                        {
                            var hour = h;
                            <MudSelectItem T="int" Value="@hour">@hour.ToString("D2"):00</MudSelectItem>
                        }
                    </MudSelect>
                    <ValidationMessage For="@(() => newAppt.Hour)" class="text-danger small mt-1" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField T="string" @bind-Value="newAppt.Notes" Label="Note (opțional)" Lines="3" Variant="Variant.Outlined" Placeholder="Adaugă detalii suplimentare pentru medic..." />
                    <ValidationMessage For="@(() => newAppt.Notes)" class="text-danger small mt-1" />
                </MudItem>
            </MudGrid>

            <div class="d-flex justify-end gap-3 mt-6">
                <MudButton Variant="Variant.Text" OnClick="CloseModal" Class="fw-medium">Anulează</MudButton>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@isSaving" Class="fw-bold px-6 shadow-sm rounded-pill">
                    @if (isSaving)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <span class="ms-2">Se trimite...</span>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Send" Class="me-2" /> <span>Trimite Cererea</span>
                    }
                </MudButton>
            </div>
        </EditForm>
    </MudPaper>
</MudOverlay>

@* Payment Modal - 3 Payment Options *@
<MudOverlay Visible="@(paymentAppt != null)" DarkBackground="true" AutoClose="false" ZIndex="9999">
    @if (paymentAppt != null)
    {
        <MudPaper Class="pa-6 rounded-xl animate-fade-in" Width="500px" MaxWidth="95vw" Elevation="8">
            <div class="d-flex justify-space-between align-center mb-2">
                <div>
                    <MudText Typo="Typo.h5" Color="Color.Primary" Class="fw-bold d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.CreditCard" Class="me-2" /> Confirmare Plată
                    </MudText>
                    <MudText Typo="Typo.body2" Class="text-muted">Alege metoda de plată pentru programare.</MudText>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="ClosePaymentModal" Color="Color.Default" Size="Size.Small" />
            </div>

            <MudPaper Elevation="0" Class="pa-4 my-4 bg-light rounded-lg d-flex justify-space-between align-center">
                <div>
                    <MudText Typo="Typo.caption" Class="text-muted text-uppercase fw-bold ls-1">Pacient</MudText>
                    <MudText Typo="Typo.body1" Class="fw-semibold">@paymentAppt.DentistName</MudText>
                </div>
                <div class="text-end">
                    <MudText Typo="Typo.caption" Class="text-muted text-uppercase fw-bold ls-1">Cost</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Success" Class="fw-bold">@paymentAppt.Cost?.ToString("N0") RON</MudText>
                </div>
            </MudPaper>

            <MudText Typo="Typo.body2" Class="text-muted mb-4">Selectează una din următoarele opțiuni:</MudText>

            <div class="d-flex flex-column gap-3 mb-6">
                @* Option 1: Stripe Payment *@
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large" Class="py-3 px-4 d-flex justify-start text-start" Style="text-transform: none; border-width: 2px;" OnClick="@(async () => await ProcessPayment(paymentAppt.Id, "stripe"))" Disabled="@(processingId != null)">
                    <div class="d-flex align-center w-100">
                        <div class="me-4"><MudIcon Icon="@Icons.Material.Filled.CreditCard" Size="Size.Large" /></div>
                        <div class="flex-grow-1">
                            <span class="d-block fw-bold fs-6">Plată cu Stripe</span>
                            <span class="text-muted small">Card de credit/debit online</span>
                        </div>
                        @if (processingId == paymentAppt.Id) { <MudProgressCircular Size="Size.Small" Indeterminate="true" /> }
                        else { <MudIcon Icon="@Icons.Material.Filled.ChevronRight" /> }
                    </div>
                </MudButton>

                @* Option 2: Cash/POS Payment *@
                <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Large" Class="py-3 px-4 d-flex justify-start text-start" Style="text-transform: none; border-width: 2px;" OnClick="@(async () => await ProcessPayment(paymentAppt.Id, "cash"))" Disabled="@(processingId != null)">
                    <div class="d-flex align-center w-100">
                        <div class="me-4"><MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Large" /></div>
                        <div class="flex-grow-1">
                            <span class="d-block fw-bold fs-6">Plată la Cabinet</span>
                            <span class="text-muted small">Cash sau POS la sosire</span>
                        </div>
                        @if (processingId == paymentAppt.Id) { <MudProgressCircular Size="Size.Small" Indeterminate="true" /> }
                        else { <MudIcon Icon="@Icons.Material.Filled.ChevronRight" /> }
                    </div>
                </MudButton>

                @* Option 3: Reject *@
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Large" Class="py-3 px-4 d-flex justify-start text-start" Style="text-transform: none; border-width: 2px;" OnClick="@(async () => await ProcessPayment(paymentAppt.Id, "reject"))" Disabled="@(processingId != null)">
                    <div class="d-flex align-center w-100">
                        <div class="me-4"><MudIcon Icon="@Icons.Material.Filled.Cancel" Size="Size.Large" /></div>
                        <div class="flex-grow-1">
                            <span class="d-block fw-bold fs-6">Respinge Programarea</span>
                            <span class="text-muted small">Nu pot ajunge la programare</span>
                        </div>
                        @if (processingId == paymentAppt.Id) { <MudProgressCircular Size="Size.Small" Indeterminate="true" /> }
                        else { <MudIcon Icon="@Icons.Material.Filled.ChevronRight" /> }
                    </div>
                </MudButton>
            </div>

            <MudAlert Severity="Severity.Info" Class="mt-2 text-sm">
                <strong>Atenție:</strong> Confirmarea prezenței te angajează să vii la programare. În caz de imposibilitate, anulează cu cel puțin 24h înainte.
            </MudAlert>
        </MudPaper>
    }
</MudOverlay>

@* Smart Scheduling Recommendations Modal *@
<MudOverlay @bind-Visible="showSmartModal" DarkBackground="true" AutoClose="false" ZIndex="9999">
    <MudPaper Class="pa-6 rounded-xl animate-fade-in" Width="900px" MaxWidth="95vw" MaxHeight="90vh" Style="overflow-y: auto;" Elevation="8">
        <div class="d-flex justify-space-between align-center mb-2">
            <div>
                <MudText Typo="Typo.h5" Color="Color.Primary" Class="fw-bold d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Lightbulb" Class="me-2" /> Recomandări Programare AI
                </MudText>
                <MudText Typo="Typo.body2" Class="text-muted">Completează preferințele pentru a primi cele mai bune intervale disponibile.</MudText>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CloseSmartModal" Color="Color.Default" Size="Size.Small" />
        </div>

        <EditForm Model="smartModel" OnValidSubmit="GetSmartRecommendations">
            <MudGrid Class="my-4">
                <MudItem xs="12" md="6">
                    <MudSelect T="string" @bind-Value="smartModel.DoctorId" Label="Medic *" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem T="string" Value="@("")">-- Alege medicul --</MudSelectItem>
                        @foreach (var d in filteredDoctors)
                        {
                            <MudSelectItem T="string" Value="@d.Id">Dr. @d.FullName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                
                <MudItem xs="12" md="6">
                    <MudSelect T="string" @bind-Value="smartModel.TimeOfDay" Label="Perioada Zilei" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem T="string" Value="@("morning")">Dimineața (08:00 - 12:00)</MudSelectItem>
                        <MudSelectItem T="string" Value="@("afternoon")">După-amiaza (12:00 - 17:00)</MudSelectItem>
                        <MudSelectItem T="string" Value="@("evening")">Seara (17:00+)</MudSelectItem>
                    </MudSelect>
                </MudItem>
                
                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Date="smartModelDateStart" Label="De la data" Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" />
                </MudItem>
                
                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Date="smartModelDateEnd" Label="Până la data" Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" />
                </MudItem>

                <MudItem xs="12">
                    <MudSwitch @bind-Value="smartModel.IsEmergency" Color="Color.Error" Label="Marchează ca urgență medicală (Durere acută)" />
                </MudItem>
            </MudGrid>
            
            <div class="d-flex justify-end mb-6">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@isSmartLoading" Class="rounded-pill px-6 fw-bold">
                    @if (isSmartLoading)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <span class="ms-2">Căutare...</span>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Search" Class="me-2" /> <span>Caută Interval</span>
                    }
                </MudButton>
            </div>
        </EditForm>

        @if (isSmartLoading)
        {
            <div class="text-center py-5 border-top">
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" Class="mb-3" />
                <MudText Typo="Typo.body1" Class="text-muted fw-semibold">Sistemul AI caută cele mai bune variante...</MudText>
            </div>
        }
        else if (aiProposals != null)
        {
            if (aiProposals.Count == 0)
            {
                <MudAlert Severity="Severity.Warning" Class="mt-4">
                    Niciun slot nu s-a potrivit preferințelor tale. Încearcă să extinzi perioada sau să renunți la preferința de oră.
                </MudAlert>
            }
            else
            {
                <MudDivider Class="my-4" />
                <MudText Typo="Typo.h6" Color="Color.Primary" Class="fw-semibold mb-4">Opțiuni Găsite:</MudText>
                
                <div class="d-flex flex-column gap-3">
                    @foreach (var slot in aiProposals)
                    {
                        <MudPaper Elevation="2" Class="pa-4 rounded pointer hover-lift" Style="cursor:pointer;" @onclick="() => SelectSmartSlot(slot)">
                            <MudGrid>
                                <MudItem xs="12" sm="8">
                                    <MudText Typo="Typo.subtitle1" Class="fw-bold d-flex align-center mb-1">
                                        <MudIcon Icon="@Icons.Material.Filled.EventAvailable" Color="Color.Primary" Class="me-2" Size="Size.Small" /> @slot.StartTime.ToString("dd MMMM yyyy")
                                    </MudText>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.AccessTime" Class="mb-2">@slot.StartTime.ToString("HH:mm") - @slot.EndTime.ToString("HH:mm")</MudChip>
                                    <MudText Typo="Typo.body2" Class="text-muted fst-italic">
                                        <MudIcon Icon="@Icons.Material.Filled.FormatQuote" Size="Size.Small" Class="me-1" /> @slot.Reason
                                    </MudText>
                                </MudItem>
                                <MudItem xs="12" sm="4" Class="d-flex flex-column align-end justify-center">
                                    <MudChip T="string" Color="@GetSmartColor(slot.Score)" Size="Size.Medium" Class="fw-bold mb-2">Potrivire: @slot.Score%</MudChip>
                                    <MudText Typo="Typo.caption" Color="Color.Primary" Class="fw-bold d-flex align-center">ALEGE <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" /></MudText>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }
                </div>
            }
        }
    </MudPaper>
</MudOverlay>

@code {
    private DateTime? newApptDateFilter
    {
        get => newAppt.Date == default ? null : newAppt.Date;
        set => newAppt.Date = value ?? DateTime.Today;
    }
    
    private DateTime? smartModelDateStart
    {
        get => smartModel.PreferredDateStart;
        set => smartModel.PreferredDateStart = value;
    }

    private DateTime? smartModelDateEnd
    {
        get => smartModel.PreferredDateEnd;
        set => smartModel.PreferredDateEnd = value;
    }

    private MudBlazor.Color GetSmartColor(double score) => score switch
    {
        >= 80 => MudBlazor.Color.Success,
        >= 50 => MudBlazor.Color.Warning,
        _ => MudBlazor.Color.Error
    };

    private List<AppointmentDto> appointments = new();
    private List<DoctorDto> doctors = new();
    private List<DoctorDto> filteredDoctors = new();
    private bool showModal = false;
    private bool isLoading = true;
    private bool isSaving = false;
    private string? successMessage;
    private string? errorMessage;
    private NewAppointmentModel newAppt = new();
    private string? currentUserId;
    private bool isDoctor = false;
    private Guid? processingId;
    private const string ApiBaseUrl = "http://localhost:5062";
    private AppointmentDto? paymentAppt;

    private string GetFullImageUrl(string? relativeUrl)
    {
        if (string.IsNullOrEmpty(relativeUrl)) return "";
        if (relativeUrl.StartsWith("http")) return relativeUrl;
        // Prefix with ApiBaseUrl if it's a relative path to the API, but AWS S3 URLs might lack this and be relative to bucket or API route if proxied
        if (!relativeUrl.StartsWith("/"))
        {
            relativeUrl = "/" + relativeUrl;
        }
        return $"{ApiBaseUrl}{relativeUrl}";
    }

    protected override async Task OnInitializedAsync()
    {
        // Acum userId e setat corect de /api/auth/me la login
        currentUserId = await LocalStorage.GetItemAsync<string>("userId");

        // Fallback: incercam din userClaims
        if (string.IsNullOrEmpty(currentUserId))
        {
            var storedClaims = await LocalStorage.GetItemAsync<List<StoredClaim>>("userClaims");
            currentUserId = storedClaims?.FirstOrDefault(c => c.Type == "sub")?.Value;
        }

        // Check if current user is a doctor
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        isDoctor = authState.User.IsInRole("Doctor");

        await LoadDoctors();
        await LoadAppointments();
    }

    private async Task LoadDoctors()
    {
        try 
        { 
            doctors = await Http.GetFromJsonAsync<List<DoctorDto>>("api/doctors") ?? new();
            // Filter out current doctor if user is a doctor
            if (isDoctor && !string.IsNullOrEmpty(currentUserId))
            {
                filteredDoctors = doctors.Where(d => d.Id != currentUserId).ToList();
            }
            else
            {
                filteredDoctors = doctors;
            }
        }
        catch { doctors = new(); filteredDoctors = new(); }
    }

    private async Task LoadAppointments()
    {
        isLoading = true;
        try
        {
            if (!string.IsNullOrEmpty(currentUserId))
            {
                if (isDoctor)
                {
                    // Doctors see their scheduled appointments with other doctors
                    appointments = await Http.GetFromJsonAsync<List<AppointmentDto>>($"api/appointments/patient/{currentUserId}") ?? new();
                }
                else
                {
                    // Patients see their appointments with doctors
                    appointments = await Http.GetFromJsonAsync<List<AppointmentDto>>($"api/appointments/patient/{currentUserId}") ?? new();
                }
            }
        }
        catch (Exception ex) { errorMessage = $"Eroare la încărcarea programărilor: {ex.Message}"; }
        finally { isLoading = false; }
    }

    private async Task ConfirmAppointment(Guid appointmentId)
    {
        processingId = appointmentId;
        errorMessage = null;
        try
        {
            // Status 4 = Confirmed
            var response = await Http.PutAsJsonAsync($"api/appointments/{appointmentId}/status", new { Status = 4 });
            if (response.IsSuccessStatusCode)
            {
                var appt = appointments.FirstOrDefault(a => a.Id == appointmentId);
                if (appt != null) appt.Status = 4;
                successMessage = "Ai confirmat prezența la programare!";
            }
            else
            {
                errorMessage = "Nu s-a putut confirma programarea.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Eroare: " + ex.Message;
        }
        finally
        {
            processingId = null;
        }
    }

    private string GetStatusClass(int status) => status switch
    {
        0 => "bg-warning text-dark bg-opacity-25 border border-warning", // Pending
        1 => "bg-info text-dark bg-opacity-10 border border-info", // Accepted by Doc
        2 => "bg-danger text-danger bg-opacity-10 border border-danger", // Rejected
        3 => "bg-secondary text-white", // Cancelled
        4 => "bg-primary text-primary bg-opacity-10 border border-primary", // Confirmed by Patient
        5 => "bg-success text-success bg-opacity-10 border border-success", // Completed/Paid
