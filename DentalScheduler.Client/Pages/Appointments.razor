@page "/appointments"
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using Blazored.LocalStorage
@attribute [Authorize]
@inject HttpClient Http
@inject ILocalStorageService LocalStorage

<PageTitle>Programările Mele</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">📅 Programările Mele</h2>
        <button class="btn btn-primary" @onclick="ShowModal">
            <i class="bi bi-plus-lg"></i> Programare Nouă
        </button>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            @if (isLoading)
            {
                <div class="text-center py-4">
                    <div class="spinner-border text-primary"></div>
                    <p class="mt-2">Se încarcă programările...</p>
                </div>
            }
            else if (appointments == null || appointments.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-calendar-x fs-1 text-muted"></i>
                    <p class="mt-3 text-muted">Nu ai nicio programare. Apasă "Programare Nouă" pentru a crea una.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Data</th>
                                <th>Ora</th>
                                <th>Medic</th>
                                <th>Tratament</th>
                                <th>Note</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appt in appointments)
                            {
                                <tr>
                                    <td>@appt.StartAt.ToShortDateString()</td>
                                    <td>@appt.StartAt.ToShortTimeString()</td>
                                    <td>Dr. @(appt.DentistName ?? "—")</td>
                                    <td>@(appt.TreatmentType ?? "—")</td>
                                    <td>@(appt.Notes ?? "—")</td>
                                    <td><span class="badge @GetStatusClass(appt.Status)">@GetStatusLabel(appt.Status)</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@* Modal Programare Nouă *@
@if (showModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Programare Nouă</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@newAppt" OnValidSubmit="SaveAppointment">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />

                        <div class="mb-3">
                            <label class="form-label">Medic <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="newAppt.DentistId" required>
                                <option value="">-- Alege medicul --</option>
                                @foreach (var d in doctors)
                                {
                                    <option value="@d.Id">Dr. @d.FullName</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Tip Tratament <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="newAppt.TreatmentType">
                                <option value="">-- Alege tratamentul --</option>
                                <option value="Control periodic">Control periodic</option>
                                <option value="Detartraj">Detartraj</option>
                                <option value="Obturaţie (Plombă)">Obturaţie (Plombă)</option>
                                <option value="Extracţie">Extracţie</option>
                                <option value="Implant">Implant</option>
                                <option value="Albire dentară">Albire dentară</option>
                                <option value="Consultaţie">Consultaţie</option>
                            </select>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Data <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" @bind="newAppt.Date" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Ora <span class="text-danger">*</span></label>
                                <select class="form-select" @bind="newAppt.Hour">
                                    @for (int h = 8; h <= 17; h++)
                                    {
                                        var hour = h;
                                        <option value="@hour">@hour.ToString("D2"):00</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Note (opţional)</label>
                            <textarea class="form-control" rows="2" @bind="newAppt.Notes"></textarea>
                        </div>

                        <div class="modal-footer px-0 pb-0">
                            <button type="button" class="btn btn-secondary" @onclick="CloseModal">Anulează</button>
                            <button type="submit" class="btn btn-primary" disabled="@isSaving">
                                @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                Trimite Cererea
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<AppointmentDto> appointments = new();
    private List<DoctorDto> doctors = new();
    private bool showModal = false;
    private bool isLoading = true;
    private bool isSaving = false;
    private string? successMessage;
    private string? errorMessage;
    private NewAppointmentModel newAppt = new();
    private string? currentUserId;

    protected override async Task OnInitializedAsync()
    {
        // Acum userId e setat corect de /api/auth/me la login
        currentUserId = await LocalStorage.GetItemAsync<string>("userId");

        // Fallback: incercam din userClaims
        if (string.IsNullOrEmpty(currentUserId))
        {
            var storedClaims = await LocalStorage.GetItemAsync<List<StoredClaim>>("userClaims");
            currentUserId = storedClaims?.FirstOrDefault(c => c.Type == "sub")?.Value;
        }

        await LoadDoctors();
        await LoadAppointments();
    }

    private async Task LoadDoctors()
    {
        try { doctors = await Http.GetFromJsonAsync<List<DoctorDto>>("api/doctors") ?? new(); }
        catch { doctors = new(); }
    }

    private async Task LoadAppointments()
    {
        isLoading = true;
        try
        {
            if (!string.IsNullOrEmpty(currentUserId))
                appointments = await Http.GetFromJsonAsync<List<AppointmentDto>>($"api/appointments/patient/{currentUserId}") ?? new();
        }
        catch (Exception ex) { errorMessage = $"Eroare la încărcarea programărilor: {ex.Message}"; }
        finally { isLoading = false; }
    }

    private void ShowModal() { newAppt = new(); showModal = true; }
    private void CloseModal() { showModal = false; }

    private async Task SaveAppointment()
    {
        if (string.IsNullOrEmpty(newAppt.DentistId) || string.IsNullOrEmpty(newAppt.TreatmentType) || newAppt.Date == default)
        {
            errorMessage = "Completează toate câmpurile obligatorii.";
            return;
        }

        if (string.IsNullOrEmpty(currentUserId) || !Guid.TryParse(currentUserId, out var patientGuid))
        {
            errorMessage = "Sesiunea a expirat. Te rugăm să te autentifici din nou.";
            return;
        }

        if (!Guid.TryParse(newAppt.DentistId, out var dentistGuid))
        {
            errorMessage = "Medicul selectat nu este valid.";
            return;
        }

        isSaving = true;
        try
        {
            var startAt = newAppt.Date.Date.AddHours(newAppt.Hour);
            var command = new
            {
                PatientId = patientGuid,
                DentistId = dentistGuid,
                StartAt = startAt,
                EndAt = startAt.AddHours(1),
                Notes = newAppt.Notes,
                TreatmentType = newAppt.TreatmentType
            };

            var response = await Http.PostAsJsonAsync("api/appointments", command);
            if (response.IsSuccessStatusCode)
            {
                successMessage = "Programarea a fost trimisă cu succes și aşteaptă confirmare!";
                showModal = false;
                await LoadAppointments();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                errorMessage = $"Eroare la salvarea programării: {err}";
            }
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { isSaving = false; }
    }

    private string GetStatusClass(int status) => status switch
    {
        1 => "bg-success",
        2 => "bg-danger",
        3 => "bg-secondary",
        _ => "bg-warning text-dark"
    };

    private string GetStatusLabel(int status) => status switch
    {
        1 => "Acceptat",
        2 => "Respins",
        3 => "Anulat",
        _ => "În aşteptare"
    };

    public class AppointmentDto
    {
        public Guid Id { get; set; }
        public Guid PatientId { get; set; }
        public Guid DentistId { get; set; }
        public DateTime StartAt { get; set; }
        public DateTime EndAt { get; set; }
        public string? Notes { get; set; }
        public string? TreatmentType { get; set; }
        public int Status { get; set; }
        public string? PatientName { get; set; }
        public string? DentistName { get; set; }
    }

    public class DoctorDto
    {
        public string Id { get; set; } = "";
        public string FullName { get; set; } = "";
        public string Email { get; set; } = "";
    }

    public class NewAppointmentModel
    {
        public string DentistId { get; set; } = "";
        public string TreatmentType { get; set; } = "";
        public DateTime Date { get; set; } = DateTime.Today.AddDays(1);
        public int Hour { get; set; } = 9;
        public string? Notes { get; set; }
    }

    public class StoredClaim
    {
        public string Type { get; set; } = "";
        public string Value { get; set; } = "";
    }
}
