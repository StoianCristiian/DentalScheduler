    public class SmartRecommendationModel
    {
        public string DoctorId { get; set; } = string.Empty;
        public int ProcedureDurationMinutes { get; set; } = 30;
        public DateTime? PreferredDateStart { get; set; } = DateTime.Today;
        public DateTime? PreferredDateEnd { get; set; } = DateTime.Today.AddDays(7);
