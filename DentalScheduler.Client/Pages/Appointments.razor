    {
        showSmartModal = false;
    }

    private async Task GetSmartRecommendations()
    {
        if (string.IsNullOrEmpty(smartModel.DoctorId) || string.IsNullOrEmpty(currentUserId))
        {
            errorMessage = "Selectează un medic mai întâi.";
            return;
        }

        isSmartLoading = true;
        errorMessage = null;

        try
        {
            // Am corectat formatarea datelor din ToString("O") în ToString("yyyy-MM-dd") 
            // pentru a evita caracterul '+' din fusul orar, care ne-encodat în URL rupea model binding-ul in .NET (Eroarea 400 Bad Request)
            var query = $"?PatientId={currentUserId}&DoctorId={smartModel.DoctorId}" +
                        $"&ProcedureDurationMinutes={smartModel.ProcedureDurationMinutes}" +
                        $"&PreferredDateStart={smartModel.PreferredDateStart?.ToString("yyyy-MM-dd")}" +
                        $"&PreferredDateEnd={smartModel.PreferredDateEnd?.ToString("yyyy-MM-dd")}" +
                        $"&TimeOfDay={smartModel.TimeOfDay}" +
                        $"&IsEmergency={smartModel.IsEmergency}";

            var response = await Http.GetFromJsonAsync<SchedulingResponseDto>($"api/appointments/recommend{query}");
            
            if (response != null && response.Proposals.Any())
            {
                aiProposals = response.Proposals;
            }
            else
            {
                errorMessage = "Nu s-au găsit slot-uri potrivite conform preferințelor tale.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Eroare la generarea recomandărilor: " + ex.Message;
        }
        finally
        {
            isSmartLoading = false;
        }
    }

    private void SelectSmartSlot(ProposedSlotDto slot)
    {
        // Pre-populăm modal-ul de "Programare Nouă" cu slot-ul ales
        newAppt = new NewAppointmentModel
        {
            DentistId = slot.DoctorId,
            Date = slot.StartTime.Date,
            Hour = slot.StartTime.Hour
        };
        
        CloseSmartModal();
        ShowModal();
    }

    private async Task SaveAppointment()
    {
        isSaving = true;
        errorMessage = null;
        successMessage = null;

        try 
        {
            var dateTime = newAppt.Date.AddHours(newAppt.Hour);
            var appointmentDto = new
            {
                PatientId = currentUserId,
                DentistId = newAppt.DentistId,
                TreatmentType = newAppt.TreatmentType,
                StartAt = dateTime,
                DurationMinutes = 60,
                Notes = newAppt.Notes
            };
            
            var response = await Http.PostAsJsonAsync("api/appointments", appointmentDto);
            if (response.IsSuccessStatusCode)
            {
                successMessage = "Cererea de programare a fost trimisă cu succes!";
                CloseModal();
                await LoadAppointments();
            }
            else
            {
                errorMessage = "Nu s-a putut crea programarea. Verificați disponibilitatea.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Eroare: " + ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ProcessPayment(Guid appointmentId, string method)
    {
        processingId = appointmentId;
        
        if (method == "stripe")
        {
            Navigation.NavigateTo($"/payment/stripe/{appointmentId}");
            processingId = null;
            return;
        }
        else if (method == "cash")
        {
            // Just confirm for now, payment happens on site
            await ConfirmAppointment(appointmentId);
            ClosePaymentModal();
        }
        else if (method == "reject")
        {
             // Implement rejection logic if needed, currently we just map it to an API call or status update
             // For now, let's assume we want to update status to Rejected (2)
             try
             {
                 var response = await Http.PutAsJsonAsync($"api/appointments/{appointmentId}/status", new { Status = 2 });
                 if (response.IsSuccessStatusCode)
                 {
                     var appt = appointments.FirstOrDefault(a => a.Id == appointmentId);
                     if (appt != null) appt.Status = 2; // Rejected
                     successMessage = "Ai refuzat programarea.";
                 }
                 else
                 {
                    errorMessage = "Nu s-a putut refuza programarea.";
                 }
             }
             catch (Exception ex)
             {
                 errorMessage = $"Eroare: {ex.Message}";
             }
             finally 
             {
                 ClosePaymentModal();
                 processingId = null;
             }
        }
    }

