@page "/doctor-dashboard"
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@using Blazored.LocalStorage
@using DentalScheduler.Client.Components.Doctor
@using DentalScheduler.Client.Models

@attribute [Authorize(Roles = "Doctor")]
@inject HttpClient Http
@inject ILocalStorageService LocalStorage

<PageTitle>Dashboard Medic</PageTitle>

<div class="container mt-4 animate-fade-in">
    @* Header Section *@
    <div class="d-flex justify-content-between align-items-end mb-5">
        <div>
            <h6 class="text-uppercase text-primary small fw-bold ls-2 mb-2">Doctor Dashboard</h6>
            <h1 class="mb-0 fw-bold display-6">Salut! 👋</h1>
            <p class="text-muted mb-0 mt-2">Iată situația programărilor pentru <span class="text-dark fw-bold">@DateTime.Now.ToString("dd MMMM yyyy")</span></p>
        </div>
        <button class="btn btn-white border shadow-sm btn-hover-effect text-primary fw-bold px-4 py-2" @onclick="LoadAppointments">
            <i class="bi bi-arrow-clockwise me-2"></i> Actualizează
        </button>
    </div>

    <AlertMessage Message="@successMessage" Type="AlertMessage.AlertType.Success" />
    <AlertMessage Message="@errorMessage" Type="AlertMessage.AlertType.Danger" />

    <DoctorStats Appointments="appointments" />

    <DoctorFilters 
        @bind-FilterDate="filterDate" 
        @bind-ActiveFilter="activeFilter"
        Appointments="appointments"
        OnApply="LoadAppointments"
        OnClearDate="ClearDateFilter" />

    <AppointmentsTable 
        FilteredAppointments="FilteredAppointments.ToList()"
        IsLoading="isLoading"
        ProcessingId="processingId"
        UpdateStatus="UpdateStatus"
        OpenPriceModal="OpenPriceModal"
        OpenFinalModal="OpenFinalModal" />
</div>

@* Price Setting Modal *@
@if (priceAppt != null)
{
    <div class="modal-backdrop fade show" style="background-color: rgba(0, 0, 0, 0.5); backdrop-filter: blur(2px);"></div>
    <div class="modal fade show d-block animate-fade-in" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header border-bottom-0 p-4 bg-light">
                    <div>
                        <h5 class="modal-title fw-bold text-primary mb-1">
                            <i class="bi bi-cash-coin me-2"></i>Setează Preț
                        </h5>
                        <p class="text-muted small mb-0">Stabilește costul pentru aceasta programare.</p>
                    </div>
                    <button type="button" class="btn-close shadow-none" @onclick="ClosePriceModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Pacient</label>
                        <div class="form-control bg-light border-0">@priceAppt.PatientName</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tratament</label>
                        <div class="form-control bg-light border-0">@priceAppt.TreatmentType</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold text-secondary small text-uppercase ls-1">Preț (RON)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-currency-exchange"></i></span>
                            <input type="number" class="form-control border-start-0 ps-0" 
                                   @bind="priceAmount" 
                                   placeholder="0.00" 
                                   step="0.01" 
                                   min="0"
                                   @onfocus="() => priceAmount = priceAmount == 0 ? null : priceAmount" />
                        </div>
                        <small class="text-muted">Introdu suma pe care o vei percepe pentru acest tratament.</small>
                    </div>

                    <div class="alert alert-info border-start border-4 mb-4">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        <small>După ce setezi prețul, pacientul va vedea 3 opțiuni de plată:</small>
                        <ul class="mb-0 mt-2 small">
                            <li>💳 Plată cu Stripe</li>
                            <li>💰 Plată la cabinet (cash/POS)</li>
                            <li>❌ Respinge programarea</li>
                        </ul>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-light px-4 fw-medium" @onclick="ClosePriceModal">Anulează</button>
                        <button type="button" class="btn btn-primary px-4 fw-medium shadow-sm" 
                                @onclick="ProcessPrice"
                                disabled="@(processingId != null || priceAmount <= 0)">
                            @if (processingId != null)
                            { <span class="spinner-border spinner-border-sm me-2"></span> }
                            <i class="bi bi-check-lg me-1"></i>Confirmă Preț
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@* Final Payment Modal *@
@if (finalAppt != null)
{
    <div class="modal-backdrop fade show" style="background-color: rgba(0, 0, 0, 0.5); backdrop-filter: blur(2px);"></div>
    <div class="modal fade show d-block animate-fade-in" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header border-bottom-0 p-4 bg-light">
                    <div>
                        <h5 class="modal-title fw-bold text-success mb-1">
                            <i class="bi bi-check-circle me-2"></i>Finalizează Programare
                        </h5>
                        <p class="text-muted small mb-0">Confirm ați finalizarea și adăugați costuri suplimentare dacă e nevoie.</p>
                    </div>
                    <button type="button" class="btn-close shadow-none" @onclick="CloseFinalModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Pacient</label>
                        <div class="form-control bg-light border-0">@finalAppt.PatientName</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Cost inițial</label>
                        <div class="form-control bg-light border-0">
                            <strong class="text-success">@finalAppt.Cost?.ToString("N0") RON</strong>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold text-secondary small text-uppercase ls-1">Costuri Suplimentare (RON)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-plus-circle"></i></span>
                            <input type="number" class="form-control border-start-0 ps-0" 
                                   @bind="additionalCost" 
                                   placeholder="0.00" 
                                   step="0.01" 
                                   min="0" />
                        </div>
                        <small class="text-muted">Lasă 0 dacă nu sunt costuri suplimentare.</small>
                    </div>

                    <div class="alert alert-success border-start border-4 mb-4">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        <strong>Total final: @(((finalAppt.Cost ?? 0) + (additionalCost ?? 0)).ToString("N0")) RON</strong>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-light px-4 fw-medium" @onclick="CloseFinalModal">Anulează</button>
                        <button type="button" class="btn btn-success px-4 fw-medium shadow-sm" 
                                @onclick="ProcessFinal"
                                disabled="@(processingId != null)">
                            @if (processingId != null)
                            { <span class="spinner-border spinner-border-sm me-2"></span> }
                            <i class="bi bi-check-lg me-1"></i>Finalizează
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<AppointmentDto> appointments = new();
    private bool isLoading = true;
    private int activeFilter = -1;
    private DateTime? filterDate;
    private string? successMessage;
    private string? errorMessage;
    private Guid? processingId;
    private string? currentUserId;
    private AppointmentDto? priceAppt;
    private decimal? priceAmount;
    private AppointmentDto? finalAppt;
    private decimal? additionalCost = 0;

    private IEnumerable<AppointmentDto> FilteredAppointments
    {
        get
        {
            if (activeFilter == -1)
            {
                if (filterDate.HasValue)
                {
                    return appointments.Where(a => a.StartAt.Date == filterDate.Value.Date);
                }
                return appointments;
            }
            return appointments.Where(a => a.Status == activeFilter);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        currentUserId = await LocalStorage.GetItemAsync<string>("userId");
        filterDate = DateTime.Today;
        await LoadAppointments();
    }

    private async Task LoadAppointments()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            if (!string.IsNullOrEmpty(currentUserId))
            {
                var url = $"api/appointments/doctor/{currentUserId}";
                if (filterDate.HasValue)
                {
                    url += $"?date={filterDate.Value:yyyy-MM-dd}";
                }
                appointments = await Http.GetFromJsonAsync<List<AppointmentDto>>(url) ?? new();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Eroare la încărcarea programărilor: {ex.Message}";
        }
        finally { isLoading = false; }
    }

    private void ClearDateFilter()
    {
        filterDate = null;
        LoadAppointments();
    }

    private async Task UpdateStatus(Guid appointmentId, int status, decimal? cost)
    {
        processingId = appointmentId;
        errorMessage = null;
        try
        {
            var response = await Http.PutAsJsonAsync($"api/appointments/{appointmentId}/status", new { Status = status, Cost = cost });
            if (response.IsSuccessStatusCode)
            {
                var appt = appointments.FirstOrDefault(a => a.Id == appointmentId);
                if (appt != null)
                {
                    appt.Status = status;
                    if (cost.HasValue) appt.Cost = cost.Value;
                }
                
                successMessage = status switch
                {
                    1 => "Preț setat! Pacientul va vedea opțiunile de plată.",
                    2 => "Programarea a fost respinsă.",
                    5 => "Programare finalizată!",
                    _ => "Statusul a fost actualizat."
                };
            }
            else
            {
                errorMessage = "A apărut o eroare la actualizarea statusului.";
            }
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { processingId = null; }
    }

    private void OpenPriceModal(AppointmentDto appt)
    {
        priceAppt = appt;
        priceAmount = null;
    }

    private void ClosePriceModal()
    {
        priceAppt = null;
        priceAmount = null;
    }

    private async Task ProcessPrice()
    {
        if (priceAppt == null || !priceAmount.HasValue || priceAmount <= 0) return;

        await UpdateStatus(priceAppt.Id, 1, priceAmount.Value);
        ClosePriceModal();
        await LoadAppointments();
    }

    private void OpenFinalModal(AppointmentDto appt)
    {
        finalAppt = appt;
        additionalCost = 0;
    }

    private void CloseFinalModal()
    {
        finalAppt = null;
        additionalCost = 0;
    }

    private async Task ProcessFinal()
    {
        if (finalAppt == null) return;

        var totalCost = (finalAppt.Cost ?? 0) + (additionalCost ?? 0);
        await UpdateStatus(finalAppt.Id, 5, totalCost);
        CloseFinalModal();
        await LoadAppointments();
    }
}
