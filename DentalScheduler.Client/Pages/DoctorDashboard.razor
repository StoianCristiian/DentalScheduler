@page "/doctor-dashboard"
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@using Blazored.LocalStorage
@using DentalScheduler.Client.Components.Doctor
@using DentalScheduler.Client.Models

@attribute [Authorize(Roles = "Doctor")]
@inject HttpClient Http
@inject ILocalStorageService LocalStorage

<PageTitle>Dashboard Medic</PageTitle>

<div class="container mt-4 animate-fade-in">
    @* Header Section *@
    <div class="d-flex justify-content-between align-items-end mb-5">
        <div>
            <h6 class="text-uppercase text-primary small fw-bold ls-2 mb-2">Doctor Dashboard</h6>
            <h1 class="mb-0 fw-bold display-6">Salut! 👋</h1>
            <p class="text-muted mb-0 mt-2">Iată situația programărilor pentru <span class="text-dark fw-bold">@DateTime.Now.ToString("dd MMMM yyyy")</span></p>
        </div>
        <button class="btn btn-white border shadow-sm btn-hover-effect text-primary fw-bold px-4 py-2" @onclick="LoadAppointments">
            <i class="bi bi-arrow-clockwise me-2"></i> Actualizează
        </button>
    </div>

    <AlertMessage Message="@successMessage" Type="AlertMessage.AlertType.Success" />
    <AlertMessage Message="@errorMessage" Type="AlertMessage.AlertType.Danger" />

    <DoctorStats Appointments="appointments" />

    <DoctorFilters 
        @bind-FilterDate="filterDate" 
        @bind-ActiveFilter="activeFilter"
        Appointments="appointments"
        OnApply="LoadAppointments"
        OnClearDate="ClearDateFilter" />

    <AppointmentsTable 
        FilteredAppointments="FilteredAppointments.ToList()"
        IsLoading="isLoading"
        ProcessingId="processingId"
        UpdateStatus="UpdateStatus"
        OpenPaymentModal="OpenPaymentModal" />
</div>

<PaymentModal 
    PaymentAppt="paymentAppt"
    @bind-PaymentAmount="paymentAmount"
    ProcessingId="processingId"
    OnClose="ClosePaymentModal"
    OnProcess="ProcessPayment" />

@code {
    private List<AppointmentDto> appointments = new();
    private bool isLoading = true;
    private int activeFilter = -1;
    private DateTime? filterDate;
    private string? successMessage;
    private string? errorMessage;
    private Guid? processingId;
    private string? currentUserId;
    private AppointmentDto? paymentAppt;
    private decimal paymentAmount;

    private IEnumerable<AppointmentDto> FilteredAppointments
    {
        get
        {
            if (activeFilter == -1)
            {
                // Tab-ul "Toate": arată doar programările din ziua selectată (dacă există filtru de dată)
                // Excludem programările Pending din alte zile care au fost aduse doar pentru contor/tab-ul Pending
                if (filterDate.HasValue)
                {
                    return appointments.Where(a => a.StartAt.Date == filterDate.Value.Date);
                }
                return appointments;
            }
            // Tab-uri specifice: arată tot ce e în listă cu statusul respectiv
            return appointments.Where(a => a.Status == activeFilter);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        currentUserId = await LocalStorage.GetItemAsync<string>("userId");
        filterDate = DateTime.Today;
        await LoadAppointments();
    }

    private async Task LoadAppointments()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            if (!string.IsNullOrEmpty(currentUserId))
            {
                var url = $"api/appointments/doctor/{currentUserId}";
                if (filterDate.HasValue)
                {
                    url += $"?date={filterDate.Value:yyyy-MM-dd}";
                }
                appointments = await Http.GetFromJsonAsync<List<AppointmentDto>>(url) ?? new();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Eroare la încărcarea programărilor: {ex.Message}";
        }
        finally { isLoading = false; }
    }

    private void ClearDateFilter()
    {
        filterDate = null;
        LoadAppointments();
    }

    private async Task UpdateStatus(Guid appointmentId, int status)
    {
        processingId = appointmentId;
        errorMessage = null;
        try
        {
            var response = await Http.PutAsJsonAsync($"api/appointments/{appointmentId}/status", new { Status = status });
            if (response.IsSuccessStatusCode)
            {
                var appt = appointments.FirstOrDefault(a => a.Id == appointmentId);
                if (appt != null) appt.Status = status;
                
                if (status == 1)
                    successMessage = "Programarea a fost acceptată!";
                else if (status == 2)
                    successMessage = "Programarea a fost respinsă.";
                else if (status == 5)
                    successMessage = "Programare finalizată și plătită!";
                else
                    successMessage = "Statusul programării a fost actualizat.";
            }
            else
            {
                errorMessage = "A apărut o eroare la actualizarea statusului.";
            }
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { processingId = null; }
    }

    private void OpenPaymentModal(AppointmentDto appt)
    {
        paymentAppt = appt;
        paymentAmount = 0;
    }

    private void ClosePaymentModal()
    {
        paymentAppt = null;
    }

    private async Task ProcessPayment()
    {
        if (paymentAppt == null) return;

        processingId = paymentAppt.Id;
        errorMessage = null;
        try
        {
            var response = await Http.PutAsJsonAsync($"api/appointments/{paymentAppt.Id}/status", new { Status = 5, Cost = paymentAmount });
            if (response.IsSuccessStatusCode)
            {
                paymentAppt.Status = 5;
                paymentAppt.Cost = paymentAmount; // Update local view
                successMessage = "Programare finalizată și încasată!";
                ClosePaymentModal();
            }
            else
            {
                errorMessage = "Eroare la procesarea plății.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Eroare la procesarea plății: {ex.Message}";
        }
        finally
        {
            processingId = null;
            ClosePaymentModal();
            await LoadAppointments();
        }
    }
}
