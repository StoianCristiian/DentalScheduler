@page "/not-found"
@layout MainLayout
@inject NavigationManager Navigation

<PageTitle>404 - Pagina nu a fost găsită</PageTitle>

<div class="container d-flex flex-column align-items-center justify-content-center" style="min-height: 60vh;">
    <div class="text-center animate-fade-in">
        <div class="mb-3">
            <i class="bi bi-emoji-frown text-primary" style="font-size: 5rem; opacity: 0.8;"></i>
        </div>
        
        <h1 class="display-1 fw-bold text-primary mb-2">404</h1>
        <h2 class="h4 mb-4 text-muted fw-normal">Pagina nu a fost găsită</h2>
        
        <div class="mx-auto mb-5" style="max-width: 500px;">
            <p class="text-secondary fs-5">
                Ne pare rău, dar pagina pe care o căutați nu există sau a fost mutată.
            </p>
        </div>

        <button class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm" @onclick="GoHome">
            <i class="bi bi-house-door-fill me-2"></i>Înapoi la Acasă
        </button>
    </div>
</div>

@code {
    private void GoHome()
    {
        Navigation.NavigateTo("/");
    }
}
