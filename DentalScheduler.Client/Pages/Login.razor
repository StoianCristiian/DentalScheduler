@page "/login"
@using System.ComponentModel.DataAnnotations
@using Blazored.LocalStorage
@using DentalScheduler.Client.Auth
@using MudBlazor
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Autentificare</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16 animate-fade-in">
    <MudPaper Elevation="4" Class="pa-8 rounded-lg">
        <div class="d-flex flex-column align-center mb-6">
            <MudIcon Icon="@Icons.Material.Filled.LocalHospital" Color="Color.Primary" Size="Size.Large" Class="mb-2" />
            <MudText Typo="Typo.h4" Class="fw-bold text-center">👋 Bine ai revenit!</MudText>
            <MudText Typo="Typo.body2" Color="Color.Default" Class="opacity-75 text-center mt-1">Introdu datele pentru a te autentifica pe platformă</MudText>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
        }

        <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <MudTextField @bind-Value="loginModel.Email" 
                          Label="Email" 
                          Variant="Variant.Outlined" 
                          Margin="Margin.Normal"
                          Adornment="Adornment.Start" 
                          AdornmentIcon="@Icons.Material.Filled.Email"
                          For="@(() => loginModel.Email)"
                          Immediate="true" />

            <MudTextField @bind-Value="loginModel.Password" 
                          Label="Parola" 
                          Variant="Variant.Outlined"
                          Margin="Margin.Normal"
                          InputType="InputType.Password"
                          Adornment="Adornment.Start" 
                          AdornmentIcon="@Icons.Material.Filled.Lock"
                          For="@(() => loginModel.Password)"
                          Immediate="true" />
            
            <div class="d-flex justify-center mt-6 mb-4">
                <MudButton ButtonType="ButtonType.Submit" 
                           Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           Size="Size.Large" 
                           FullWidth="true" 
                           Class="rounded-pill fw-bold"
                           Disabled="@isLoading">
                    @if (isLoading)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Se autentifică...</MudText>
                    }
                    else
                    {
                        <MudText>Autentifică-te</MudText>
                    }
                </MudButton>
            </div>
        </EditForm>

        <div class="text-center mt-6">
            <MudText Typo="Typo.body2" Class="text-muted">
                Nu ai cont? <MudLink Href="register" Color="Color.Primary" Underline="Underline.Always" Class="fw-bold">Creează unul acum</MudLink>
            </MudText>
        </div>
    </MudPaper>
</MudContainer>

@code {
    private LoginModel loginModel = new();
    private string? errorMessage;
    private bool isLoading = false;

    private async Task HandleLogin()
    {
        errorMessage = null;
        isLoading = true;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/auth/login?useCookies=false", loginModel);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<LoginResponse>();
                await LocalStorage.SetItemAsync("authToken", result!.AccessToken);

                // Setam token-ul pe HttpClient pentru request-ul urmator
                Http.DefaultRequestHeaders.Authorization =
                    new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", result.AccessToken);

                // Obtinem userId si rolul direct de la server - cel mai sigur mod
                var meResponse = await Http.GetAsync("/api/auth/me");
                if (meResponse.IsSuccessStatusCode)
                {
                    var me = await meResponse.Content.ReadFromJsonAsync<MeResponse>();
                    if (me != null)
                    {
                        await LocalStorage.SetItemAsync("userId", me.Id);
                        await LocalStorage.SetItemAsync("userRole", me.Role);
                        if (!string.IsNullOrEmpty(me.ProfilePictureUrl))
                        {
                            await LocalStorage.SetItemAsync("profilePictureUrl", me.ProfilePictureUrl);
                        }

                        // Salvam si claims pentru AuthorizeView
                        var claims = new List<StoredClaim>
                        {
                            new StoredClaim { Type = "sub", Value = me.Id },
                            new StoredClaim { Type = "role", Value = me.Role },
                            new StoredClaim { Type = "email", Value = me.Email }
                        };
                        await LocalStorage.SetItemAsync("userClaims", claims);

                        ((CustomAuthenticationStateProvider)AuthStateProvider).MarkUserAsAuthenticated(result.AccessToken, claims);

                        if (me.Role == "Doctor")
                            Navigation.NavigateTo("/doctor-dashboard");
                        else
                            Navigation.NavigateTo("/appointments");

                        return;
                    }
                }

                // Fallback daca /me esueaza
                ((CustomAuthenticationStateProvider)AuthStateProvider).MarkUserAsAuthenticated(result.AccessToken, new List<StoredClaim>());
                Navigation.NavigateTo("/appointments");
            }
            else
            {
                errorMessage = "Email sau parola incorecta.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    public class LoginModel
    {
        [Required] [EmailAddress] public string Email { get; set; } = string.Empty;
        [Required] public string Password { get; set; } = string.Empty;
    }

    public class LoginResponse
    {
        public string TokenType { get; set; } = "";
        public string AccessToken { get; set; } = "";
        public int ExpiresIn { get; set; }
        public string RefreshToken { get; set; } = "";
    }

    public class MeResponse
    {
        public string Id { get; set; } = "";
        public string Role { get; set; } = "";
        public string Email { get; set; } = "";
        public string? ProfilePictureUrl { get; set; }
    }
}
