@page "/login"
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using Blazored.LocalStorage
@using Microsoft.AspNetCore.Components.Authorization
@using DentalScheduler.Client.Auth
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthStateProvider

<h3>Autentificare</h3>

<div class="row">
    <div class="col-md-4">
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <InputText id="email" class="form-control" @bind-Value="loginModel.Email" />
            </div>
            
            <div class="mb-3">
                <label for="password" class="form-label">Parola</label>
                <InputText id="password" type="password" class="form-control" @bind-Value="loginModel.Password" />
            </div>

            <button type="submit" class="btn btn-primary">Login</button>
        </EditForm>
    </div>
</div>

@code {
    private LoginModel loginModel = new();
    private string? errorMessage;

    private async Task HandleLogin()
    {
        errorMessage = null;
        try
        {
            // Login query parameter useCookies=true or useSessionCookies=true for browser scenarios 
            // is common with Identity API, but for SPA usually we get a token (Bearer).
            // Default MapIdentityApi returns AccessToken and RefreshToken in JSON body if accepting JSON.
            
            var response = await Http.PostAsJsonAsync("/api/auth/login?useCookies=false", loginModel);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<LoginResponse>();
                
                // Salvam token-ul in LocalStorage
                await LocalStorage.SetItemAsync("authToken", result!.AccessToken);
                
                // Notificam aplicatia ca utilizatorul s-a autentificat
                ((CustomAuthenticationStateProvider)AuthStateProvider).MarkUserAsAuthenticated(result.AccessToken);
                
                Navigation.NavigateTo("/");
            }
            else
            {
                errorMessage = "Email sau parola incorecta.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    public class LoginModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required]
        public string Password { get; set; } = string.Empty;
    }

    public class LoginResponse
    {
        public string TokenType { get; set; }
        public string AccessToken { get; set; }
        public int ExpiresIn { get; set; }
        public string RefreshToken { get; set; }
    }
}
