@page "/payment/stripe/{appointmentId:guid}"
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@using Blazored.LocalStorage
@inject IJSRuntime JS
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ILocalStorageService LocalStorage

<PageTitle>Plată cu Stripe</PageTitle>

<div class="container mt-4 animate-fade-in">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <div class="mb-3">
                            <i class="bi bi-credit-card" style="font-size: 3rem; color: #0d6efd;"></i>
                        </div>
                        <h2 class="fw-bold mb-2">Plată cu Stripe</h2>
                        <p class="text-muted">Programare ID: <small>@AppointmentId</small></p>
                    </div>

                    @if (isLoading)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Se încarcă...</span>
                            </div>
                            <p class="mt-2 text-muted">Se inițializează plata securizată...</p>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
                            <div class="mt-2 text-end">
                                <button class="btn btn-sm btn-outline-danger" @onclick="InitializePayment">Încearcă din nou</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div id="payment-element" class="mb-4">
                            <!-- Stripe Elements va injecta formularul aici -->
                        </div>

                        <button @onclick="ProcessPayment" disabled="@isProcessing" class="btn btn-primary w-100 py-3 fw-bold shadow-sm">
                            @if (isProcessing)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Se procesează...</span>
                            }
                            else
                            {
                                <span><i class="bi bi-lock-fill me-2"></i>Plătește Acum</span>
                            }
                        </button>
                    }
                    
                    <div class="mt-4 text-center">
                        <button class="btn btn-link text-muted text-decoration-none btn-sm" @onclick="GoBack">
                            <i class="bi bi-arrow-left me-1"></i> Înanpoi la programări
                        </button>
                    </div>

                    <div class="mt-3 text-center text-muted small">
                        <i class="bi bi-shield-lock-fill me-1"></i> Plată securizată de Stripe SSL 256-bit
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Guid AppointmentId { get; set; }

    private bool isLoading = true;
    private bool isProcessing = false;
    private bool isStripeInitialized = false; // Flag nou pentru a preveni initializari multiple
    private string? errorMessage;
    private string? clientSecret;
    private string? publishableKey;

    protected override async Task OnInitializedAsync()
    {
        await InitializePayment();
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!isLoading && !string.IsNullOrEmpty(clientSecret) && !string.IsNullOrEmpty(publishableKey) && !isStripeInitialized)
        {
            isStripeInitialized = true;
            await JS.InvokeVoidAsync("stripeInterop.initialize", publishableKey, clientSecret);
        }
    }

    private async Task InitializePayment()
    {
        isLoading = true;
        errorMessage = null;
        isStripeInitialized = false;

        try
        {
            var response = await Http.PostAsync($"api/stripe/init-payment/{AppointmentId}", null);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<PaymentInitResult>();
                clientSecret = result?.ClientSecret;
                publishableKey = result?.PublishableKey;
                
                if (string.IsNullOrEmpty(clientSecret) || string.IsNullOrEmpty(publishableKey))
                {
                    errorMessage = "Nu s-au putut obține datele de configurare pentru plată.";
                }
                // Nu mai apelam JS aici, ci lăsăm OnAfterRenderAsync să o facă după ce UI-ul se randează
            }
            else
            {
                var errorMsg = await response.Content.ReadAsStringAsync();
                errorMessage = $"Eroare server: {errorMsg}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"A apărut o eroare neașteptată: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ProcessPayment()
    {
        isProcessing = true;
        errorMessage = null;

        try
        {
            // URL-ul de întoarcere după plată (ajunge înapoi în aplicație)
            var returnUrl = Navigation.ToAbsoluteUri("/appointments").ToString();
            
            var result = await JS.InvokeAsync<PaymentResult>("stripeInterop.confirmPayment", returnUrl);

            if (result.Success)
            {
                // Payment succeeded in Stripe, now sync status with backend
                // This is a fallback in case webhooks are delayed or not working (localhost)
                try 
                {
                    await Http.PostAsync($"api/stripe/sync-status/{AppointmentId}", null);
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Sync warning: {ex.Message}");
                    // We continue anyway as Stripe said success
                }

                // Stripe va face redirect automat, dar pentru siguranță:
                Navigation.NavigateTo("/appointments");
            }
            else
            {
                errorMessage = result.Error ?? "Plata a eșuat.";
                isProcessing = false;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Eroare la procesarea plății: {ex.Message}";
            isProcessing = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/appointments");
    }

    public class PaymentInitResult
    {
        public string PublishableKey { get; set; } = string.Empty;
        public string ClientSecret { get; set; } = string.Empty;
        public string StripePaymentIntentId { get; set; } = string.Empty;
    }

    public class PaymentResult
    {
        public bool Success { get; set; }
        public string? Error { get; set; }
    }
}
