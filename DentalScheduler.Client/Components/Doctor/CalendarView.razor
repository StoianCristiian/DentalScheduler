@using System.Globalization

<div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
    <div class="card-header bg-primary text-white border-bottom-0 p-3">
        <h5 class="fw-bold mb-0"><i class="bi bi-calendar-event me-2"></i>Calendar Programări - @TargetDate.ToString("dd MMMM yyyy", new CultureInfo("ro-RO"))</h5>
    </div>
    <div class="card-body p-4 bg-light">
        <div class="d-flex overflow-auto pb-2 gap-3 align-items-stretch custom-scrollbar" style="min-height: 160px;">
            @for (int hour = 8; hour <= 20; hour++)
            {
                var currentHour = hour;
                var slotAppointments = Appointments.Where(a => a.StartAt.Hour == currentHour).ToList();
                var hasAppointments = slotAppointments.Any();
                
                <div class="card border-0 shadow-sm flex-shrink-0" style="width: 140px; transition: transform 0.2s;">
                    <div class="card-body p-3 text-center d-flex flex-column h-100 @(hasAppointments ? "bg-white" : "bg-light opacity-75")">
                        <div class="fw-bold fs-5 mb-3 @(hasAppointments ? "text-primary" : "text-secondary")">@currentHour:00</div>
                        
                        <div class="d-flex flex-column gap-2 flex-grow-1 justify-content-center">
                            @if (hasAppointments)
                            {
                                @foreach (var appt in slotAppointments)
                                {
                                    var statusInfo = GetStatusInfo(appt.Status);
                                    <div class="badge @statusInfo.CssClass w-100 py-2 border rounded-3 fw-medium text-wrap" style="line-height: 1.2;" title="@appt.PatientName">
                                        @statusInfo.Text
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-muted small">Liber</div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .custom-scrollbar::-webkit-scrollbar {
        height: 8px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #c1c1c1;
        border-radius: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #a8a8a8;
    }
</style>

@code {
    [Parameter]
    public List<AppointmentDto> Appointments { get; set; } = new();

    [Parameter]
    public DateTime TargetDate { get; set; } = DateTime.Today;

    private (string Text, string CssClass) GetStatusInfo(int status) => status switch
    {
        0 => ("În așteptare", "bg-warning text-dark"),
        1 => ("Preț trimis", "bg-info text-dark"),
        2 => ("Respinsă", "bg-danger"),
        3 => ("Confirmată", "bg-primary"),
        4 => ("Plătit avans", "bg-primary"),
        5 => ("Finalizată", "bg-success"),
        _ => ("Necunoscut", "bg-secondary")
    };
}
