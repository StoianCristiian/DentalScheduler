@using DentalScheduler.Client.Models

@* Total Revenue Display *@
<div class="d-flex justify-content-end mb-3">
    <div class="bg-success bg-opacity-10 text-success border border-success px-4 py-2 rounded-3 shadow-sm d-flex align-items-center animate-fade-in">
        <i class="bi bi-cash-stack fs-4 me-3"></i>
        <div>
            <div class="small text-uppercase fw-bold ls-1 opacity-75" style="font-size: 0.7rem;">Total Încasat</div>
            <div class="fw-bold fs-5">@TotalRevenue.ToString("N2") RON</div>
        </div>
    </div>
</div>

@* Appointments Table *@
<div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-5">
    <div class="card-body p-0">
        @if (IsLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2 text-muted fw-semibold">Se încarcă programările...</p>
            </div>
        }
        else if (!FilteredAppointments.Any())
        {
            <div class="text-center py-5">
                <div class="mb-3 text-muted opacity-25 display-1">
                    <i class="bi bi-inbox"></i>
                </div>
                <p class="text-muted fs-5">Nu există programări în această categorie.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-secondary small text-uppercase ls-1">
                        <tr>
                            <th class="border-0 py-3 ps-4">Pacient</th>
                            <th class="border-0 py-3">Tratament</th>
                            <th class="border-0 py-3">Data & Ora</th>
                            <th class="border-0 py-3">Note</th>
                            <th class="border-0 py-3">Cost</th>
                            <th class="border-0 py-3">Status</th>
                            <th class="border-0 py-3 pe-4 text-end" style="min-width: 180px;">Acţiuni</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appt in FilteredAppointments)
                        {
                            <tr>
                                <td class="ps-4 py-3">
                                    <div class="fw-semibold text-dark">@(appt.PatientName ?? "Pacient necunoscut")</div>
                                </td>
                                <td class="py-3"><span class="badge bg-light text-dark border fw-normal">@appt.TreatmentType</span></td>
                                <td class="py-3">
                                    <div class="text-dark fw-medium">@appt.StartAt.ToShortDateString()</div>
                                    <div class="text-muted small">@appt.StartAt.ToShortTimeString()</div>
                                </td>
                                <td class="py-3">
                                    @if (!string.IsNullOrEmpty(appt.Notes))
                                    {
                                        <span class="d-inline-block text-truncate text-muted small" style="max-width: 200px;" title="@appt.Notes">
                                            @appt.Notes
                                        </span>
                                    }
                                    else { <span class="text-muted">—</span> }
                                </td>
                                <td class="py-3">
                                    @if (appt.Cost.HasValue)
                                    {
                                        <span class="fw-bold text-success">@appt.Cost.Value.ToString("N0") RON</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td class="py-3">
                                    <span class="badge rounded-pill px-3 py-2 @GetStatusClass(appt.Status)">@GetStatusLabel(appt.Status)</span>
                                </td>
                                <td class="py-3 pe-4 text-end">
                                    @if (appt.Status == 0) // Pending - Doctor needs to accept and set price
                                    {
                                        <button type="button" class="btn btn-primary btn-sm"
                                                @onclick="() => OnOpenPriceModal(appt)"
                                                disabled="@(ProcessingId == appt.Id)"
                                                title="Setează preț și acceptă">
                                            @if (ProcessingId == appt.Id)
                                            { <span class="spinner-border spinner-border-sm me-1"></span> }
                                            <i class="bi bi-cash-coin me-1"></i> Acceptă
                                        </button>
                                        <button type="button" class="btn btn-danger btn-sm ms-2"
                                                @onclick="() => OnUpdateStatus(appt.Id, 2)"
                                                disabled="@(ProcessingId == appt.Id)"
                                                title="Respinge">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    }
                                    else if (appt.Status == 4) // Confirmed by Patient - Doctor finishes and adds final cost if needed
                                    {
                                        <button class="btn btn-success btn-sm"
                                                @onclick="() => OnOpenFinalModal(appt)"
                                                disabled="@(ProcessingId == appt.Id)">
                                            @if (ProcessingId == appt.Id)
                                            { <span class="spinner-border spinner-border-sm me-1"></span> }
                                            <i class="bi bi-check-circle me-1"></i> Finalizează
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">Finalizat</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public List<AppointmentDto> FilteredAppointments { get; set; } = new();
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public Guid? ProcessingId { get; set; }
    [Parameter] public Func<Guid, int, decimal?, Task>? UpdateStatus { get; set; }
    [Parameter] public EventCallback<AppointmentDto> OpenPriceModal { get; set; }
    [Parameter] public EventCallback<AppointmentDto> OpenFinalModal { get; set; }

    private decimal TotalRevenue => FilteredAppointments
        .Where(a => a.Status == 5)
        .Sum(a => a.Cost ?? 0);

    private async Task OnUpdateStatus(Guid id, int status)
    {
        if (UpdateStatus != null)
        {
            await UpdateStatus(id, status, null);
        }
    }

    private async Task OnOpenPriceModal(AppointmentDto appt)
    {
        await OpenPriceModal.InvokeAsync(appt);
    }

    private async Task OnOpenFinalModal(AppointmentDto appt)
    {
        await OpenFinalModal.InvokeAsync(appt);
    }
    
    private string GetStatusClass(int status) => status switch
    {
        0 => "bg-warning text-dark bg-opacity-25 border border-warning",
        1 => "bg-info text-dark bg-opacity-10 border border-info",
        2 => "bg-danger text-danger bg-opacity-10 border border-danger",
        3 => "bg-secondary text-white",
        4 => "bg-primary text-primary bg-opacity-10 border border-primary",
        5 => "bg-success text-success bg-opacity-10 border border-success",
        _ => "bg-secondary"
    };

    private string GetStatusLabel(int status) => status switch
    {
        0 => "⏳ În așteptare",
        1 => "💰 Preț setat - Așteaptă răspuns",
        2 => "❌ Respins",
        3 => "🚫 Anulat",
        4 => "👍 Confirmat de pacient",
        5 => "✅ Finalizat",
        _ => "Necunoscut"
    };
}
