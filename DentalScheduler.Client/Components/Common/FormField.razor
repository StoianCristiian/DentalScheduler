<div class="mb-3">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="form-label fw-semibold text-secondary small text-uppercase ls-1">@Label</label>
    }
    
    @ChildContent

    @if (ValidationFor != null)
    {
        <div class="text-danger small mt-1">
            <ValidationMessage For="@ValidationFor" />
        </div>
    }
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public System.Linq.Expressions.Expression<Func<object>>? ValidationFor { get; set; }
}

